# Virtual environments
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/

# Gate output. The gate's exit code is read with `; echo $?`, never through a pipe,
# so runs are routinely redirected to a log.
gate*.log

# Editor and OS noise
*.swp
*.swo
.DS_Store

# Build artefacts
build/
dist/
*.egg-info/

# uv.lock is intentionally NOT ignored: it is the reproducible resolution of the
# dependency set approved in the backend charter §4.

# Agent-local scratch. Durable lessons live in docs/instructions/specialist-dispatch-lessons.md,
# which is the delivery lead's to write and is pasted verbatim into every dispatch. Two homes for
# one lesson is how they drift (see R13). Ruling R12.
**/.claude/agent-memory/
**/.claude/worktrees/
